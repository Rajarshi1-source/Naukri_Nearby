# NaukriNearby backend — environment template. Copy to .env and fill in.
# NEVER commit a real .env. Only this .env.example (empty placeholders) is tracked.

# --- Datastores (defaults match compose.yaml; override for remote infra) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/naukrinearby
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_ELASTICSEARCH_URIS=http://localhost:9200

# --- Object storage (MinIO / S3-compatible) ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=resumes

# --- JWT (RS256). Leave blank in dev to auto-generate an ephemeral keypair. ---
# In production set PEM PKCS#8 private + X.509 public keys (newlines as \n).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# --- CORS (Next.js origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- OTP (stub = fixed dev code, no Twilio Verify call) ---
OTP_PROVIDER=stub
OTP_DEV_CODE=123456

# --- LLM extraction (REAL). Set provider=gpt5mini and supply a key + base URL. ---
EXTRACTION_PROVIDER=gpt5mini
EXTRACTION_MODEL=gpt-5-mini
VISION_MODEL=gpt-5-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=

# --- Embeddings (local = deterministic offline default; set provider=remote for bge-m3 HTTP) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMS=1024
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=

# --- Translation (stub = passthrough English; set provider=bhashini for real) ---
TRANSLATION_PROVIDER=stub
BHASHINI_BASE_URL=
BHASHINI_API_KEY=

# --- Twilio WhatsApp (stub = log + record, no send) ---
TWILIO_PROVIDER=stub
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WEBHOOK_URL=http://localhost:8080/api/webhooks/twilio

# --- Resume-extraction eval gate (enabled only in CI / local eval runs) ---
EVAL_ENABLED=false
EVAL_API_KEY=
